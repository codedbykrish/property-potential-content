# Copy to .env (never commit it). Run with: npx tsx --env-file=.env src/cli.ts ... or export these.

# Claude: fact extraction, photo labelling, angles, script. Without it, --mock is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ElevenLabs voiceover. Without it, the voice is silent (mock) and the Reel can't be approved.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Runway: optional AI stills and camera motion. Off unless RUNWAY_ENABLED=true.
RUNWAYML_API_SECRET=
RUNWAY_ENABLED=false
RUNWAY_MAX_CLIPS=3

# EPC register (free key from https://epc.opendatacommunities.org/) for floor area and energy rating.
EPC_API_EMAIL=
EPC_API_KEY=

# The content agent's OWN Supabase project (not the Property Potential app's). Optional for local runs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where jobs are kept locally.
PP_DATA_DIR=data
PP_REVIEWER=krish

# Optional: a Chrome/Chromium binary for Remotion. Unset, Remotion downloads its own on first render.
REMOTION_BROWSER_EXECUTABLE=
